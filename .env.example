# Hawaii SNAP Voice-Guided Assistant Environment Configuration

# OpenRouter TTS (Free Fish Audio endpoint: fish-audio/s2.1-pro-free:free)
# Sign up at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_VOICE=

# Direct Fish Audio (Optional alternative)
# Sign up free at: https://fish.audio/app/api-keys
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free

# Groq Whisper Configuration
# Sign up free (no card required) at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Whisper model on Groq (whisper-large-v3-turbo is the fastest)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Hawaii PAIS Benefits Portal URL
PORTAL_URL=https://pais-benefits.dhs.hawaii.gov/
